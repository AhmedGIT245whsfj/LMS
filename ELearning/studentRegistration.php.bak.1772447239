          <?php
            if (!isset($conn)) { include_once __DIR__ . '/dbConnection.php'; }
            $rs = $conn->query("SELECT track_id, track_name FROM track ORDER BY track_id");
            if ($rs) {
              while ($t = $rs->fetch_assoc()) {
                $tid = (int)$t['track_id'];
                $tname = htmlspecialchars($t['track_name'] ?? '', ENT_QUOTES);
                echo "<option value=\"{$tid}\">{$tname}</option>";
              }
            }
          ?>
        </select>
